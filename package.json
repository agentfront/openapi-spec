{
  "name": "openapi-spec",
  "version": "1.0.0",
  "description": "Up-to-date TypeScript types and readers for Swagger 2.0 and OpenAPI 3.0, 3.1 and 3.2",
  "author": "AgentFront <info@agentfront.dev>",
  "license": "Apache-2.0",
  "packageManager": "yarn@4.14.1",
  "keywords": [
    "openapi",
    "openapi-3.2",
    "openapi-3.1",
    "openapi-3.0",
    "openapi3",
    "swagger",
    "swagger-2.0",
    "oas",
    "oas3",
    "specification",
    "types",
    "typescript",
    "typescript-types",
    "json-schema",
    "swagger-to-openapi",
    "converter",
    "api",
    "rest"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentfront/openapi-spec.git"
  },
  "bugs": {
    "url": "https://github.com/agentfront/openapi-spec/issues"
  },
  "homepage": "https://github.com/agentfront/openapi-spec#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/esm/index.mjs"
      }
    }
  },
  "scripts": {
    "build:cjs": "esbuild src/index.ts --bundle --platform=node --format=cjs --outdir=dist --packages=external",
    "build:esm": "esbuild src/index.ts --bundle --platform=node --format=esm --outdir=dist/esm --out-extension:.js=.mjs --packages=external",
    "build:types": "tsc -p tsconfig.lib.json --emitDeclarationOnly",
    "build": "yarn build:cjs && yarn build:esm && yarn build:types && cp package.json dist/ && node scripts/strip-dist-from-pkg.js dist/package.json && cp README.md LICENSE dist/",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest -c jest.e2e.config.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && tsc -p e2e/tsconfig.json",
    "verify:sources": "node scripts/sync-oas-sources.mjs",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "yarn clean && yarn build && yarn test"
  },
  "devDependencies": {
    "@swc/core": "~1.16.1",
    "@swc/helpers": "^0.5.18",
    "@swc/jest": "~0.2.38",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "ajv": "^8.17.0",
    "ajv-draft-04": "^1.0.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.1",
    "tslib": "^2.8.1",
    "typescript": "^5.0.0",
    "yaml": "^2.9.0"
  },
  "resolutions": {
    "@istanbuljs/load-nyc-config/js-yaml": "^5.4.2",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
